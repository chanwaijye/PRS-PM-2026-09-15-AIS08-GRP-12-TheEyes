# Build trees. Two exist right now: SystemCode/build (current) and a stale
# top-level build/ from an earlier configure. Neither belongs in history.
build/
*.o
*.a
*.so
compile_commands.json

# Model weights. yolov8n.pt is fetched by ultralytics on demand; committing a
# 6.5 MB binary that a one-line download reproduces is not reproducibility.
# Pin the version in training/detector/ instead.
*.pt
*.pth
*.onnx
*.engine
*.plan

# Datasets and capture output. Replicator emits 4-channel .npy per frame, which
# grows without bound -- these are regenerable from the scripts that are
# tracked, which is the part that matters.
realsense_test/out/
training/detector/dataset/
datasets/
runs/
*.npy
*.bag
*.mkv
# Capture output: recorded RGB-D sessions from the live runner (~30 MB/s of PNG
# pairs) and the calibration registration views, which
# docs/CALIBRATION_PROTOCOL.md already describes as "kept on disk, not in git".
# The rule used to be captures/runtime/ only, which left those views exposed.
captures/

# USD/Blender scene files stay out -- large, and regenerable from the scripts.
#
# assets/meshes/ IS tracked (changed 2026-09-03, when the meshes landed). The
# earlier rule assumed large CAD binaries; the reality is ~15 MB of YCB OBJ plus
# textures, and every reportable number in the project is derived from this
# exact geometry. §11.1 delivers a single self-contained ZIP, so the meshes
# belong in it.
*.usd
*.usda
*.usdc
*.blend

# NOT ignored, deliberately:
#   calibration_backup/*.bin  -- 512 B factory calibration tables per device.
#                                Tiny, and they are the source of truth for
#                                every measured intrinsic quoted in the report.
#   config/extrinsics.yaml    -- regenerated by every calibration run, and the
#                                history of it across recalibrations is exactly
#                                what you want when a fused pose looks wrong.

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# SQLite metric logs: regenerable, and they churn on every run.
*.db
*.sqlite
*.sqlite3

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Rehearsal audio for presentations: regenerable from the .txt scripts beside it
# with edge-tts, and binary history grows on every re-record.
*.mp3

# Original phone photos (full-size, uncropped). Cropped, downscaled copies live
# in assets/photos/.
/photos/
